{
  "name": "jd-login-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable JD login/captcha protocol toolkit with browser-native login flow.",
  "scripts": {
    "login": "node scripts/login_browser_native.mjs",
    "login:browser": "node scripts/login_browser_native.mjs",
    "login:http": "node scripts/login_http_protocol.mjs",
    "login:protocol": "node lib/jd_login_service_protocol.mjs",
    "test": "node --test",
    "install:browsers": "npx playwright install chromium",
    "clean": "rm -rf outputs/* browser-profile && mkdir -p outputs && touch outputs/.gitkeep",
    "setup:python": "bash scripts/setup_python.sh",
    "benchmark:ddddocr": "python scripts/benchmark_ddddocr_tuned.py"
  },
  "dependencies": {
    "playwright": "^1.54.0"
  }
}
